__pycache__/
*.pyc
.venv/
venv/
.env
.env.*

# Regenerated by the paper scripts; the figures and table bodies are built from results/.
/figures/
/tables/

# Experiment outputs go to a chosen run directory; never commit API responses.
/runs/

# Rebuilt dataset case files (the builder recreates them; only arXiv abstracts and checksums ship).
/data/datasets/*/cases.jsonl
!/data/datasets/arxiv_abstracts/cases.jsonl
/data/datasets/*/cases.meta.json
!/data/datasets/arxiv_abstracts/cases.meta.json

# Downloaded trajectory benchmarks.
/data/trajectories/R-Judge/
/data/trajectories/ATBench/
